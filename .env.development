VITE_API_BASE_URL=https://education-fr-new.onrender.com/api
# Dev/demo only - shows a "Skip Payment" button on the Career Assessment,
# KCET Predictor and PGCET Predictor pages so they can be walked through with
# a client without a real Razorpay charge. The KCET/PGCET skip additionally
# requires ALLOW_DEV_SKIP_PAYMENT=true on the backend to actually take effect -
# this flag alone only controls whether the button is shown.
# Never set this in a production .env file.
VITE_ALLOW_DEV_SKIP_PAYMENT=true
